[all]
rpi-5-1
rpi-5-2
rpi-5-3
rpi-5-4
rpi-5-5
rpi-4b-1
rpi-4b-2
rpi-4b-3
rpi-3bplus-1
#rpi-5-1      ansible_host=192.168.1.30
#rpi-5-2      ansible_host=192.168.1.41
#rpi-5-3      ansible_host=192.168.1.28
#rpi-5-4      ansible_host=192.168.1.83
#rpi-5-5      ansible_host=192.168.1.95
#rpi-4b-1     ansible_host=192.168.1.13
#rpi-4b-2     ansible_host=192.168.1.14
#rpi-4b-3     ansible_host=192.168.1.18
#rpi-3bplus-1 ansible_host=192.168.1.15

# There are no hardware-class groups: the board model (pi5 / pi4 / pi3) is read from each node's device
# tree at the start of every run (roles/board_facts), which sets board_model and builds those groups for
# the run. Only DECISIONS live here: what is a server, an agent, audio.

# Control plane (k3s server: etcd + API server). Exactly three, deliberately:
# etcd needs an odd-sized quorum, and a fourth member would tolerate no more
# failures than three while needing more votes. etcd is very sensitive to disk
# fsync latency, so these are Pi 5s. They also carry disk-heavy workloads
# (Longhorn replicas on the storage=true nodes, OpenSearch on pi5=true nodes).
[server]
rpi-5-1
rpi-5-2
rpi-5-3

# Workers (k3s agent). The Pi 4B disks are slow, so nothing with heavy disk
# activity is pinned to them. rpi-5-4 is a Pi 5 and is the exception: it is the
# node Postgres's optional `local` mode pins to
# (apps/postgres/cluster/components/local).
[agent]
rpi-4b-1
rpi-4b-2
rpi-4b-3
rpi-5-4
rpi-5-5
rpi-3bplus-1

# Dedicated audio-output node (Pi 3B+, 1GB RAM, SD card). It is also an [agent];
# this group exists so playbooks can single it out. A NoSchedule taint
# (host_vars/rpi-3bplus-1.yaml) keeps everything off it except node-exporter,
# Vector and shairport-sync.
[audio]
rpi-3bplus-1

[k3s_cluster:children]
server
agent
