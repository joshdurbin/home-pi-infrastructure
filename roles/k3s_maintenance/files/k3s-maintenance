#!/usr/bin/env python3
"""
K3S Node Maintenance Script

Usage:
  k3s-maintenance -e    Enable maintenance mode (drain node)
  k3s-maintenance -d    Disable maintenance mode (uncordon node)
  k3s-maintenance -s    Show current maintenance status
  k3s-maintenance -h    Show this help

The script maintains state in /var/lib/k3s-maintenance.state
After running with -e, you can safely reboot the node.
Run with -d after reboot to return node to service.
"""

import argparse
import json
import os
import socket
import subprocess
import sys
from datetime import datetime
from pathlib import Path

STATE_FILE = Path("/var/lib/k3s-maintenance.state")
DEFAULT_DRAIN_TIMEOUT = 300  # 5 minutes


class MaintenanceManager:
    def __init__(self):
        self.node_name = self._get_node_name()
        self.state = self._load_state()

    def _get_node_name(self) -> str:
        """Get the current node's Kubernetes name.

        k3s names a node after its hostname unless --node-name is set (it
        isn't anywhere in this repo), so this node is this host. Previously
        this asked kubectl for the *first node in the cluster*
        (items[0]), which is only ever this node by coincidence - running
        the script on any other node drained the wrong one. Override with
        K3S_NODE_NAME if a node ever does use a custom --node-name.
        """
        node_name = os.environ.get("K3S_NODE_NAME") or socket.gethostname().split(".")[0]
        try:
            # Confirm the node exists under that name before touching it.
            subprocess.run(
                ["kubectl", "get", "node", node_name, "-o", "name"],
                capture_output=True,
                text=True,
                timeout=10,
                check=True,
            )
            return node_name
        except subprocess.CalledProcessError as e:
            self._error(
                f"No Kubernetes node named '{node_name}' (this host's name): "
                f"{e.stderr.strip()}\nSet K3S_NODE_NAME if this node uses a custom --node-name."
            )
        except FileNotFoundError:
            self._error("kubectl not found. Is kubectl installed and in PATH?")
        except Exception as e:
            self._error(f"Unexpected error getting node name: {e}")

    def _load_state(self) -> dict:
        """Load maintenance state from file."""
        if STATE_FILE.exists():
            try:
                with open(STATE_FILE, "r") as f:
                    return json.load(f)
            except (json.JSONDecodeError, IOError) as e:
                self._warn(f"Could not read state file: {e}, starting fresh")
                return {}
        return {}

    def _save_state(self):
        """Save maintenance state to file."""
        try:
            STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
            with open(STATE_FILE, "w") as f:
                json.dump(self.state, f, indent=2)
            STATE_FILE.chmod(0o644)
        except IOError as e:
            self._error(f"Failed to save state file: {e}")

    def _run_kubectl(self, *args, check=True):
        """Run kubectl command and return result."""
        try:
            result = subprocess.run(
                ["kubectl"] + list(args),
                capture_output=True,
                text=True,
                timeout=30,
                check=check,
            )
            return result
        except FileNotFoundError:
            self._error("kubectl not found. Is kubectl installed and in PATH?")
        except subprocess.TimeoutExpired:
            self._error(f"kubectl command timed out: {' '.join(args)}")
        except subprocess.CalledProcessError as e:
            return e  # Return error result for caller to handle

    def enable_maintenance(self):
        """Enable maintenance mode by draining the node."""
        if self.state.get("in_maintenance"):
            self._info(
                f"Node '{self.node_name}' already in maintenance since "
                f"{self.state.get('enabled_at', 'unknown')}"
            )
            return 0

        self._info(f"Enabling maintenance mode for node '{self.node_name}'...")
        self._info("Draining node of workloads...")

        # Drain the node
        result = self._run_kubectl(
            "drain",
            self.node_name,
            "--ignore-daemonsets",
            "--delete-emptydir-data",
            f"--timeout={DEFAULT_DRAIN_TIMEOUT}s",
            check=False,
        )

        if result.returncode != 0:
            self._error(
                f"Failed to drain node: {result.stderr}\n"
                "You may need to manually drain with:\n"
                f"  kubectl drain {self.node_name} --ignore-daemonsets --delete-emptydir-data"
            )

        # Update state
        self.state["in_maintenance"] = True
        self.state["enabled_at"] = datetime.now().isoformat()
        self.state["node_name"] = self.node_name
        self._save_state()

        self._success(
            f"Node '{self.node_name}' is now in maintenance mode.\n"
            "All workloads have been evicted. Safe to reboot.\n"
            f"When ready to return to service, run: k3s-maintenance -d"
        )
        return 0

    def disable_maintenance(self):
        """Disable maintenance mode by uncordoning the node."""
        if not self.state.get("in_maintenance"):
            self._info(f"Node '{self.node_name}' is not in maintenance mode")
            return 0

        self._info(f"Disabling maintenance mode for node '{self.node_name}'...")
        self._info("Uncordoning node...")

        # Uncordon the node
        result = self._run_kubectl("uncordon", self.node_name, check=False)

        if result.returncode != 0:
            self._error(
                f"Failed to uncordon node: {result.stderr}\n"
                "You may need to manually uncordon with:\n"
                f"  kubectl uncordon {self.node_name}"
            )

        # Update state
        self.state["in_maintenance"] = False
        self.state["disabled_at"] = datetime.now().isoformat()
        enabled_at = self.state.get("enabled_at", "unknown")
        self._save_state()

        self._success(
            f"Node '{self.node_name}' has been returned to service.\n"
            f"Maintenance duration: {enabled_at} to {self.state['disabled_at']}"
        )
        return 0

    def show_status(self):
        """Show current maintenance status."""
        if not self.state:
            self._info("No maintenance state recorded")
            return 0

        in_maintenance = self.state.get("in_maintenance", False)
        node_name = self.state.get("node_name", "unknown")
        enabled_at = self.state.get("enabled_at", "unknown")
        disabled_at = self.state.get("disabled_at", "N/A")

        status = "IN MAINTENANCE" if in_maintenance else "IN SERVICE"
        self._info(f"Node: {node_name}")
        self._info(f"Status: {status}")
        self._info(f"Enabled at: {enabled_at}")
        if not in_maintenance:
            self._info(f"Disabled at: {disabled_at}")

        return 0

    @staticmethod
    def _info(msg: str):
        print(f"[INFO] {msg}")

    @staticmethod
    def _warn(msg: str):
        print(f"[WARN] {msg}", file=sys.stderr)

    @staticmethod
    def _success(msg: str):
        print(f"[SUCCESS] {msg}")

    @staticmethod
    def _error(msg: str):
        print(f"[ERROR] {msg}", file=sys.stderr)
        sys.exit(1)


def main():
    parser = argparse.ArgumentParser(
        description="K3S Node Maintenance Mode Manager",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )

    action_group = parser.add_mutually_exclusive_group(required=True)
    action_group.add_argument(
        "-e", "--enable", action="store_true", help="Enable maintenance mode (drain node)"
    )
    action_group.add_argument(
        "-d", "--disable", action="store_true", help="Disable maintenance mode (uncordon node)"
    )
    action_group.add_argument(
        "-s", "--status", action="store_true", help="Show maintenance status"
    )

    args = parser.parse_args()

    manager = MaintenanceManager()

    if args.enable:
        return manager.enable_maintenance()
    elif args.disable:
        return manager.disable_maintenance()
    elif args.status:
        return manager.show_status()

    return 1


if __name__ == "__main__":
    sys.exit(main())
