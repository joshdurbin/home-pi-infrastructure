#!/usr/bin/env python3
"""
K3S Node Maintenance Script

Usage:
  k3s-maintenance -e [-n] [-f]   Enable maintenance mode (drain THIS node)
  k3s-maintenance -d [--no-wait] Disable maintenance mode (uncordon, wait for storage)
  k3s-maintenance -s             Show current maintenance status
  k3s-maintenance -h             Show this help

  -n/--dry-run  Run the safety checks and say what would happen; change nothing.
  -f/--force    Skip the safety checks (one-node-at-a-time, healthy volumes).

Enabling maintenance is built for taking every node out one at a time:
  1. Refuses if another node is already cordoned (finish and uncordon it first).
  2. Refuses if any attached Longhorn volume isn't fully healthy (a replica is
     still rebuilding) - draining now could take a volume's last good copy.
  3. If this node hosts a CloudNativePG primary, promotes a healthy replica on
     another node first (the primary's PodDisruptionBudget blocks eviction,
     and it holds Longhorn's engine for the volume, which blocks the node).
  4. Drains the node, skipping Longhorn instance-manager pods (their PDBs
     block eviction by design; they stop when the node reboots anyway).

The script maintains state in /var/lib/k3s-maintenance.state
After running with -e, you can safely reboot the node.
Run with -d after reboot to return node to service.
"""

import argparse
import json
import os
import socket
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

STATE_FILE = Path("/var/lib/k3s-maintenance.state")
DEFAULT_DRAIN_TIMEOUT = 300  # 5 minutes


class MaintenanceManager:
    def __init__(self):
        self.node_name = self._get_node_name()
        self.state = self._load_state()

    def _get_node_name(self) -> str:
        """Get the current node's Kubernetes name.

        k3s names a node after its hostname unless --node-name is set (it
        isn't anywhere in this repo), so this node is this host. Previously
        this asked kubectl for the *first node in the cluster*
        (items[0]), which is only ever this node by coincidence - running
        the script on any other node drained the wrong one. Override with
        K3S_NODE_NAME if a node ever does use a custom --node-name.
        """
        node_name = os.environ.get("K3S_NODE_NAME") or socket.gethostname().split(".")[0]
        try:
            # Confirm the node exists under that name before touching it.
            subprocess.run(
                ["kubectl", "get", "node", node_name, "-o", "name"],
                capture_output=True,
                text=True,
                timeout=10,
                check=True,
            )
            return node_name
        except subprocess.CalledProcessError as e:
            self._error(
                f"No Kubernetes node named '{node_name}' (this host's name): "
                f"{e.stderr.strip()}\nSet K3S_NODE_NAME if this node uses a custom --node-name."
            )
        except FileNotFoundError:
            self._error("kubectl not found. Is kubectl installed and in PATH?")
        except Exception as e:
            self._error(f"Unexpected error getting node name: {e}")

    def _load_state(self) -> dict:
        """Load maintenance state from file."""
        if STATE_FILE.exists():
            try:
                with open(STATE_FILE, "r") as f:
                    return json.load(f)
            except (json.JSONDecodeError, IOError) as e:
                self._warn(f"Could not read state file: {e}, starting fresh")
                return {}
        return {}

    def _save_state(self):
        """Save maintenance state to file."""
        try:
            STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
            with open(STATE_FILE, "w") as f:
                json.dump(self.state, f, indent=2)
            STATE_FILE.chmod(0o644)
        except IOError as e:
            self._error(f"Failed to save state file: {e}")

    def _run_kubectl(self, *args, check=True):
        """Run kubectl command and return result."""
        try:
            result = subprocess.run(
                ["kubectl"] + list(args),
                capture_output=True,
                text=True,
                timeout=30,
                check=check,
            )
            return result
        except FileNotFoundError:
            self._error("kubectl not found. Is kubectl installed and in PATH?")
        except subprocess.TimeoutExpired:
            self._error(f"kubectl command timed out: {' '.join(args)}")
        except subprocess.CalledProcessError as e:
            return e  # Return error result for caller to handle

    # ---- helpers -----------------------------------------------------

    def _kubectl_json(self, *args):
        """Run kubectl with -o json and return the parsed result."""
        result = self._run_kubectl(*args, "-o", "json", check=False)
        if result.returncode != 0:
            self._error(f"kubectl {' '.join(args)} failed: {result.stderr}")
        return json.loads(result.stdout)

    def _cordoned_nodes(self):
        """Names of nodes marked unschedulable, other than this one."""
        nodes = self._kubectl_json("get", "nodes")["items"]
        return sorted(
            n["metadata"]["name"]
            for n in nodes
            if n["spec"].get("unschedulable")
            and n["metadata"]["name"] != self.node_name
        )

    def _unhealthy_volumes(self):
        """Attached Longhorn volumes that are not fully healthy (still rebuilding)."""
        result = self._run_kubectl(
            "-n", "longhorn", "get", "volumes.longhorn.io", "-o", "json", check=False
        )
        if result.returncode != 0:
            # Longhorn not installed/reachable - nothing to protect.
            return []
        bad = []
        for v in json.loads(result.stdout)["items"]:
            st = v.get("status", {})
            if st.get("state") == "attached" and st.get("robustness") != "healthy":
                pvc = st.get("kubernetesStatus", {}).get("pvcName", v["metadata"]["name"])
                bad.append(f"{pvc} ({st.get('robustness', 'unknown')})")
        return sorted(bad)

    def _cnpg_primaries_here(self):
        """CloudNativePG primary pods running on this node."""
        pods = self._kubectl_json(
            "get", "pods", "-A", "-l", "cnpg.io/instanceRole=primary"
        )["items"]
        return [p for p in pods if p["spec"].get("nodeName") == self.node_name]

    def _healthy_replica_elsewhere(self, namespace, cluster):
        """Name of a Ready replica of this cluster on another schedulable node."""
        cordoned = set(self._cordoned_nodes())
        pods = self._kubectl_json(
            "-n", namespace, "get", "pods",
            "-l", f"cnpg.io/cluster={cluster},cnpg.io/instanceRole=replica",
        )["items"]
        for p in pods:
            node = p["spec"].get("nodeName")
            ready = any(
                c.get("type") == "Ready" and c.get("status") == "True"
                for c in p["status"].get("conditions", [])
            )
            if ready and node and node != self.node_name and node not in cordoned:
                return p["metadata"]["name"]
        return None

    def _promote(self, namespace, cluster, instance):
        """Promote `instance` and wait until it is the ready primary."""
        self._info(f"Promoting {namespace}/{instance} to primary of cluster '{cluster}'...")
        result = self._run_kubectl(
            "cnpg", "promote", cluster, instance, "-n", namespace, check=False
        )
        if result.returncode != 0:
            self._error(
                f"Could not promote {instance}: {result.stderr or result.stdout}\n"
                "Needs the kubectl-cnpg plugin (installed by this role). Promote by hand, then retry:\n"
                f"  kubectl cnpg promote {cluster} {instance} -n {namespace}"
            )
        deadline = time.time() + 180
        while time.time() < deadline:
            c = self._kubectl_json("-n", namespace, "get", "cluster", cluster)
            if (
                c.get("status", {}).get("currentPrimary") == instance
                and c.get("status", {}).get("phase", "").startswith("Cluster in healthy")
            ):
                self._success(f"{instance} is now the primary of '{cluster}'.")
                return
            time.sleep(5)
        self._error(
            f"Timed out waiting for {instance} to become primary of '{cluster}'. "
            f"Check: kubectl cnpg status {cluster} -n {namespace}"
        )

    # ---- actions -----------------------------------------------------

    def enable_maintenance(self, force=False, dry_run=False):
        """Enable maintenance mode: safety checks, move DB primaries, drain."""
        if self.state.get("in_maintenance") and not dry_run:
            self._info(
                f"Node '{self.node_name}' already in maintenance since "
                f"{self.state.get('enabled_at', 'unknown')}"
            )
            return 0

        tag = "[dry-run] " if dry_run else ""
        self._info(f"{tag}Enabling maintenance mode for node '{self.node_name}'...")

        # 1. One node at a time.
        others = self._cordoned_nodes()
        if others and not force:
            self._error(
                f"Other node(s) already cordoned: {', '.join(others)}.\n"
                "Maintenance is one node at a time - finish and uncordon those first "
                "(k3s-maintenance -d on that node, or: kubectl uncordon <node>),\n"
                "or re-run with --force."
            )
        elif others:
            self._warn(f"--force: other node(s) already cordoned: {', '.join(others)}")

        # 2. Storage must be fully redundant before taking a node away.
        unhealthy = self._unhealthy_volumes()
        if unhealthy and not force:
            self._error(
                "Longhorn volume(s) not fully healthy (a replica is rebuilding or degraded): "
                f"{', '.join(unhealthy)}.\nWait until they're healthy "
                "(kubectl -n longhorn get volumes.longhorn.io), or re-run with --force."
            )
        elif unhealthy:
            self._warn(f"--force: volumes not healthy: {', '.join(unhealthy)}")

        # 3. Database primaries here must move first.
        for pod in self._cnpg_primaries_here():
            ns = pod["metadata"]["namespace"]
            cluster = pod["metadata"]["labels"]["cnpg.io/cluster"]
            target = self._healthy_replica_elsewhere(ns, cluster)
            if not target:
                self._error(
                    f"{ns}/{pod['metadata']['name']} is the primary of CNPG cluster '{cluster}' "
                    "and no healthy replica exists on another schedulable node to take over. "
                    "Refusing to drain - that would take the database down."
                )
            if dry_run:
                self._info(f"{tag}would promote {ns}/{target} (primary of '{cluster}' is on this node)")
            else:
                self._promote(ns, cluster, target)

        if dry_run:
            self._info(f"{tag}checks passed; would cordon and drain '{self.node_name}'. Nothing changed.")
            return 0

        # 4. Drain. instance-manager pods excluded: their PDBs block eviction
        # by design and they stop with the node anyway (same as site.yml's
        # reboot play).
        self._info("Draining node of workloads...")
        result = self._run_kubectl(
            "drain",
            self.node_name,
            "--ignore-daemonsets",
            "--delete-emptydir-data",
            "--pod-selector", "longhorn.io/component!=instance-manager",
            f"--timeout={DEFAULT_DRAIN_TIMEOUT}s",
            check=False,
        )

        if result.returncode != 0:
            self._error(
                f"Failed to drain node: {result.stderr}\n"
                "The node is cordoned but not fully drained. Fix the blocker above and re-run, "
                f"or uncordon with: kubectl uncordon {self.node_name}"
            )

        # Update state
        self.state["in_maintenance"] = True
        self.state["enabled_at"] = datetime.now().isoformat()
        self.state["node_name"] = self.node_name
        self._save_state()

        self._success(
            f"Node '{self.node_name}' is now in maintenance mode.\n"
            "All workloads have been evicted. Safe to reboot.\n"
            f"When ready to return to service, run: k3s-maintenance -d"
        )
        return 0

    def disable_maintenance(self, wait=True):
        """Return the node to service and wait for storage to be redundant again."""
        if not self.state.get("in_maintenance"):
            self._info(f"Node '{self.node_name}' is not in maintenance mode")
            return 0

        self._info(f"Disabling maintenance mode for node '{self.node_name}'...")
        self._info("Uncordoning node...")

        # Uncordon the node
        result = self._run_kubectl("uncordon", self.node_name, check=False)

        if result.returncode != 0:
            self._error(
                f"Failed to uncordon node: {result.stderr}\n"
                "You may need to manually uncordon with:\n"
                f"  kubectl uncordon {self.node_name}"
            )

        # Update state
        self.state["in_maintenance"] = False
        self.state["disabled_at"] = datetime.now().isoformat()
        enabled_at = self.state.get("enabled_at", "unknown")
        self._save_state()

        self._success(
            f"Node '{self.node_name}' has been returned to service.\n"
            f"Maintenance duration: {enabled_at} to {self.state['disabled_at']}"
        )

        # Don't hand back a node whose storage is still rebuilding: the next
        # node's -e refuses until volumes are healthy anyway.
        if wait:
            self._info("Waiting for Longhorn volumes to be fully healthy (Ctrl-C to skip)...")
            deadline = time.time() + 900
            try:
                while time.time() < deadline:
                    bad = self._unhealthy_volumes()
                    if not bad:
                        self._success("All attached Longhorn volumes are healthy. Safe to do the next node.")
                        return 0
                    self._info(f"still rebuilding: {', '.join(bad)}")
                    time.sleep(15)
                self._warn("Timed out waiting for volumes; check: kubectl -n longhorn get volumes.longhorn.io")
            except KeyboardInterrupt:
                self._warn("Skipped waiting for volume health.")
        return 0

    def show_status(self):
        """Show current maintenance status."""
        if not self.state:
            self._info("No maintenance state recorded")
            return 0

        in_maintenance = self.state.get("in_maintenance", False)
        node_name = self.state.get("node_name", "unknown")
        enabled_at = self.state.get("enabled_at", "unknown")
        disabled_at = self.state.get("disabled_at", "N/A")

        status = "IN MAINTENANCE" if in_maintenance else "IN SERVICE"
        self._info(f"Node: {node_name}")
        self._info(f"Status: {status}")
        self._info(f"Enabled at: {enabled_at}")
        if not in_maintenance:
            self._info(f"Disabled at: {disabled_at}")

        return 0

    @staticmethod
    def _info(msg: str):
        print(f"[INFO] {msg}")

    @staticmethod
    def _warn(msg: str):
        print(f"[WARN] {msg}", file=sys.stderr)

    @staticmethod
    def _success(msg: str):
        print(f"[SUCCESS] {msg}")

    @staticmethod
    def _error(msg: str):
        print(f"[ERROR] {msg}", file=sys.stderr)
        sys.exit(1)


def main():
    parser = argparse.ArgumentParser(
        description="K3S Node Maintenance Mode Manager",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )

    action_group = parser.add_mutually_exclusive_group(required=True)
    action_group.add_argument(
        "-e", "--enable", action="store_true", help="Enable maintenance mode (drain node)"
    )
    action_group.add_argument(
        "-d", "--disable", action="store_true", help="Disable maintenance mode (uncordon node)"
    )
    action_group.add_argument(
        "-s", "--status", action="store_true", help="Show maintenance status"
    )

    parser.add_argument(
        "-n", "--dry-run", action="store_true",
        help="With -e: run the checks and report what would happen; change nothing",
    )
    parser.add_argument(
        "-f", "--force", action="store_true",
        help="With -e: skip the one-node-at-a-time and volume-health checks",
    )
    parser.add_argument(
        "--no-wait", action="store_true",
        help="With -d: don't wait for Longhorn volumes to become healthy",
    )

    args = parser.parse_args()

    manager = MaintenanceManager()

    if args.enable:
        return manager.enable_maintenance(force=args.force, dry_run=args.dry_run)
    elif args.disable:
        return manager.disable_maintenance(wait=not args.no_wait)
    elif args.status:
        return manager.show_status()

    return 1


if __name__ == "__main__":
    sys.exit(main())
