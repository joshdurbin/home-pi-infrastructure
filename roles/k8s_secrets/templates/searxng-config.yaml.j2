# Deliberately minimal - `use_default_settings: true` inherits SearXNG's
# entire shipped default engine list and general settings, so this only
# needs to override what's actually secret or environment-specific. This is
# the exact shape of the vendor's own template.settings.yml, verified via a
# real `docker run` against docker.io/searxng/searxng:2026.9.25-12f8b6515
# (not assumed from docs) - including confirming server.secret_key has no
# environment-variable equivalent, so it has to live in this file, and that
# omitting server.base_url (this cluster's tailnet hostname isn't known
# here) is fine - SearXNG auto-detects it from request headers.
use_default_settings: true

server:
  secret_key: "{{ searxng_secret_key }}"
  image_proxy: true

ui:
  static_use_hash: true

# Rate-limiter/bot-detection cache (searxng-cache, see
# apps/searxng/manifests/redis-replication.yaml). SearXNG's valkey client
# only takes one connection URL (no Sentinel awareness), but points at the
# RedisReplication's own operator-maintained "-master" Service rather than
# a specific pod - confirmed live that the redis-operator keeps this
# Service's endpoint pointed at whichever pod is actually master:
#   kubectl -n searxng-cache get redisreplication searxng-cache -o jsonpath='{.status.connectionInfo}'
#   -> {"host":"searxng-cache-master.searxng-cache.svc.cluster.local","port":6379}
# i.e. this is the CR's own documented recommended connection endpoint, so
# this *is* failover-aware despite the plain-URL limitation - an earlier
# version of this comment claimed otherwise based on incomplete research
# (the operator's docs describe roles as determined dynamically with no
# stable label, which is true, but missed that it still maintains this
# Service off that same dynamic determination).
valkey:
  url: "redis://searxng-cache-master.searxng-cache.svc.cluster.local:6379/0"
