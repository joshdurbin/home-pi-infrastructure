# LiteLLM publishes its Helm chart only as an OCI artifact
# (ghcr.io/berriai/litellm-helm, no classic chart repo). Argo CD needs OCI
# registries registered explicitly (enableOCI) before an Application can use
# one as a chart source - unlike the plain-HTTPS chart repos above, which it
# resolves on demand. Public registry, no credentials.
apiVersion: v1
kind: Secret
metadata:
  name: repo-ghcr-berriai
  namespace: {{ argocd_vars.kubernetes.namespace }}
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: helm
  name: berriai
  url: ghcr.io/berriai
  enableOCI: "true"
