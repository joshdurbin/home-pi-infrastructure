apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: home-pi
  namespace: {{ argocd_vars.kubernetes.namespace }}
spec:
  description: Everything in this repo's apps/ directory
  # Scoped to the actual chart repos and this repo's own git source - not a
  # wildcard. These only change when a new app is added (rare, deliberate),
  # unlike clusterResourceWhitelist below.
  sourceRepos:
    - https://charts.longhorn.io
    - https://prometheus-community.github.io/helm-charts
    - https://victoriametrics.github.io/helm-charts
    - https://bjw-s-labs.github.io/helm-charts
    - https://pkgs.tailscale.com/helmcharts
    - https://ot-container-kit.github.io/helm-charts
    - https://cloudnative-pg.github.io/charts
    - https://go.temporal.io/helm-charts
    - https://opensearch-project.github.io/opensearch-k8s-operator/
    - https://helm.vector.dev
    - https://kubernetes-sigs.github.io/descheduler/
    - https://aquasecurity.github.io/helm-charts/
    - https://helm.openwebui.com/
    - https://kubernetes-sigs.github.io/headlamp/
    - https://maximhq.github.io/bifrost/helm-charts
    - '{{ argocd_vars.gitops.repo_url }}'
  # Scoped to the namespaces these apps actually use.
  destinations:
    - namespace: {{ argocd_vars.kubernetes.namespace }}
      server: https://kubernetes.default.svc
    - namespace: longhorn
      server: https://kubernetes.default.svc
    - namespace: monitoring
      server: https://kubernetes.default.svc
    - namespace: blocky
      server: https://kubernetes.default.svc
    - namespace: searxng
      server: https://kubernetes.default.svc
    - namespace: tailscale
      server: https://kubernetes.default.svc
    - namespace: redis-operator
      server: https://kubernetes.default.svc
    # Dedicated namespaces for Blocky's and SearXNG's own Redis
    # replication+sentinel clusters (see apps/blocky/manifests/ and
    # apps/searxng/manifests/) - kept out of the blocky/searxng namespaces
    # themselves so their existing egress-only NetworkPolicies
    # (podSelector: {}, i.e. every pod in that namespace) don't
    # accidentally clamp down the redis/sentinel pods' own intra-cluster
    # traffic.
    - namespace: blocky-cache
      server: https://kubernetes.default.svc
    - namespace: searxng-cache
      server: https://kubernetes.default.svc
    - namespace: whodb
      server: https://kubernetes.default.svc
    - namespace: bifrost
      server: https://kubernetes.default.svc
    - namespace: go-feature-flag
      server: https://kubernetes.default.svc
    - namespace: snowflake
      server: https://kubernetes.default.svc
    - namespace: shairport-sync
      server: https://kubernetes.default.svc
    - namespace: cnpg-system
      server: https://kubernetes.default.svc
    - namespace: postgres
      server: https://kubernetes.default.svc
    - namespace: temporal
      server: https://kubernetes.default.svc
    - namespace: opensearch
      server: https://kubernetes.default.svc
    - namespace: homepage
      server: https://kubernetes.default.svc
    - namespace: descheduler
      server: https://kubernetes.default.svc
    - namespace: trivy-system
      server: https://kubernetes.default.svc
    - namespace: open-webui
      server: https://kubernetes.default.svc
    - namespace: headlamp
      server: https://kubernetes.default.svc
    # victoria-metrics-k8s-stack creates a few VMServiceScrapes directly in
    # kube-system (matching upstream kube-prometheus-stack convention) to
    # scrape control-plane components like CoreDNS from where they actually
    # run - not a namespace victoria-metrics otherwise touches.
    - namespace: kube-system
      server: https://kubernetes.default.svc
  # Left wildcarded deliberately, unlike the two above: Longhorn,
  # VictoriaMetrics, and the Tailscale Operator each install their own CRDs
  # and ClusterRoles, and a chart upgrade can introduce new cluster-scoped
  # kinds at any time. Enumerating them here would mean this list going stale
  # (and syncs silently failing) on every such upgrade, for little real
  # benefit in a single-tenant homelab with one AppProject.
  clusterResourceWhitelist:
    - group: '*'
      kind: '*'
